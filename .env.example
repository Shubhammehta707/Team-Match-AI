# HTTP port for the combined frontend/backend server.
PORT=3000

# Existing AI Studio runtime placeholders.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Optional server-side Neo4j configuration. Leave empty for demo mode.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Optional public API base URL for a separately hosted backend.
# Leave empty to use this site's origin.
VITE_API_BASE_URL=
